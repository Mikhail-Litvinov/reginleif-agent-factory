{
	"name": "agent-factory",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Agent Factory: deployment, database and services. Own package, outside Rig's bun test and typecheck.",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "node --test --test-concurrency=3 --test-global-setup=./tests/global-setup.ts \"tests/**/*.test.ts\"",
		"typecheck": "tsc --noEmit",
		"setup-secrets": "node deploy/setup-secrets.ts",
		"backup": "node deploy/backup/backup.ts",
		"restore-check": "node deploy/backup/restore-check.ts",
		"restore": "node deploy/backup/restore.ts"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"drizzle-kit": "0.31.11",
		"typescript": "^5.9.0"
	},
	"dependencies": {
		"drizzle-orm": "0.45.4",
		"postgres": "3.4.9",
		"zod": "4.6.7"
	}
}
